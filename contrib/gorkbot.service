[Unit]
Description=gorkbot Matrix LLM agent
After=network.target

[Service]
Type=simple
User=gorkbot
Group=gorkbot
WorkingDirectory=/var/lib/gorkbot
ExecStart=/usr/local/bin/gorkbot -config /etc/gorkbot/config.json
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gorkbot

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gorkbot

[Install]
WantedBy=multi-user.target
