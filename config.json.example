{
  "homeserver": "https://matrix.example.org",
  "user": "@gork:example.org",
  "password": "change-me",
  "recovery_key": "",
  "database": "gorkbot.db",
  "pickle_key": "gorkbot",
  "device_name": "gorkbot",
  "llm": {
    "base_url": "http://localhost:8080",
    "api_key": "",
    "model": "llama-3.2-3b-instruct",
    "max_history": 100,
    "history_timeout": "15m"
  },
  "llm_vision": {
    "base_url": "",
    "api_key": "",
    "model": "ggml-org/Qwen2-VL-2B-Instruct-GGUF",
    "image_prompt": "Describe what you see in this image"
  },
  "gork": {
    "system_prompt": "You are gork, a witty troglodyte. Prefer brief, poignant responses.",
    "mention": "@gork:example.org",
    "markdown": true
  },
  "backfill": {
    "max_messages": 50,
    "timeout": "24h"
  }
}
