{
  "homeserver": "https://matrix.example.org",
  "user": "@gork:example.org",
  "password": "change-me",
  "recovery_key": "",
  "database": "gorkbot.db",
  "pickle_key": "gorkbot",
  "device_name": "gorkbot",
  "llm": {
    "base_url": "http://localhost:8080",
    "api_key": "",
    "model": "llama-3.2-3b-instruct",
    "max_history": 100,
    "history_timeout": "15m"
  },
  "llm_vision": {
    "base_url": "",
    "api_key": "",
    "model": "ggml-org/Qwen2-VL-2B-Instruct-GGUF",
    "image_prompt": "Describe this image in two sentences, no markdown and no preamble. First name every subject with its colour and what it is doing; then the background and lighting.",
    "max_tokens": 200
  },
  "gork": {
    "system_prompt": "You are gork, a witty troglodyte. Prefer brief, poignant responses.",
    "mention": "@gork:example.org",
    "markdown": true
  },
  "invite": {
    "allowed_inviters": [
      "@you:example.org"
    ]
  },
  "backfill": {
    "max_messages": 50,
    "timeout": "24h"
  },
  "image": {
    "base_url": "http://localhost:8001",
    "width": 512,
    "height": 512,
    "steps": 8,
    "cfg_scale": 1,
    "lora": [
      "qwen_image_2.1_turbo_lora_avg_rank_178_bf16.safetensors"
    ],
    "timeout": "5m",
    "max_retries": 2,
    "quality": {
      "steps": 40,
      "cfg_scale": 8,
      "lora": []
    }
  }
}
